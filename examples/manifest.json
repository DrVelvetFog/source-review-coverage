{
  "package": "source-review-coverage",
  "version_cmd": "cat VERSION",
  "examples": [
    {
      "id": "quickstart",
      "path": "examples/quickstart.sh",
      "command": "bash examples/quickstart.sh"
    },
    {
      "id": "approval-tests",
      "path": "tests/action/test_approvals.sh",
      "command": "bash tests/action/test_approvals.sh 2>/dev/null | tail -1"
    },
    {
      "id": "comment-tests",
      "path": "tests/comment/test_render_comment.sh",
      "command": "bash tests/comment/test_render_comment.sh 2>/dev/null | tail -1"
    },
    {
      "id": "octopus-replay-tests",
      "path": "tests/replay/test_octopus_replay.sh",
      "command": "bash tests/replay/test_octopus_replay.sh 2>/dev/null | tail -1"
    },
    {
      "id": "check-run-tests",
      "path": "tests/check/test_render_check.sh",
      "command": "bash tests/check/test_render_check.sh 2>/dev/null | tail -1"
    },
    {
      "id": "release-check",
      "path": "tools/release_check.sh",
      "command": "bash tools/release_check.sh"
    },
    {
      "id": "verify-artifact-tests",
      "path": "tests/verify/test_verify_artifact.sh",
      "command": "bash tests/verify/test_verify_artifact.sh 2>/dev/null | tail -1"
    }
  ]
}
